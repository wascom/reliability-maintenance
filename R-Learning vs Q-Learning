    bound01 = @(x) min(1.0, max(0.0, x));
    clip    = @(x, lo, hi) min(hi, max(lo, x));
    
    res.all_hLog           = zeros(T, nIterations);
    res.all_spentU_byYear  = zeros(nYears, nIterations);
    res.all_minHealth      = zeros(nYears, nIterations);
    
    for iter = 1:nIterations
        Q = zeros(Hbins, TauBins, Sbins, 2); 
        h = 1.0; b = 1.0; s = 0.0;
        tauState = 0; tauPhys = 0;
        eps = 1.0;
        
        hL = zeros(T,1);
        yearMaintCtr = 0;
        
        for t = 1:T
            ih = toHbin(h); itau = toTaubin(tauState); is = toSbin(s);
            
            validActions = [1];
            if b >= costHM, validActions = [validActions, 2]; end
            
            % E-Greedy
            qv = squeeze(Q(ih, itau, is, :));
            [~, idxG] = max(qv(validActions));
            aGreedy = validActions(idxG);
            
            if rand < eps
                a = validActions(randi(length(validActions)));
            else
                a = aGreedy;
            end
            
            % Physics
            u_t = 0.0;
            if a == 2, u_t = costHM; end
            
            if u_t == 0
                hNext = bound01(h - lambda1 * (tauPhys^betaWear));
                bNext = b;
                tauPhysNext = tauPhys + 1;
            else
                hNext = bound01(h - lambda1 * (tauPhys^betaWear) + gainHM);
                bNext = b - u_t;
                tauPhysNext = 0;
            end
            tauStateNext = min(tauPhysNext, tauMax);
            
            % Year End
            if mod(t, weeksPerYear) == 0
                yrIdx = t / weeksPerYear;
                res.all_spentU_byYear(yrIdx, iter) = 1.0 - bNext; 
                bNext = 1.0; 
            end
            
            % Reward
            sNext = clip(s - (u_t - uStar), -sMax, sMax);
            bScoreNext = 1 - abs(sNext)/sMax;
            r = w_h * hNext + w_b * bScoreNext;
            
            % Discounted Q-Learning Update
            ihp = toHbin(hNext); itaup = toTaubin(tauStateNext); isp = toSbin(sNext);
            qvp = squeeze(Q(ihp, itaup, isp, :));
            
            validNext = [1];
            if bNext >= costHM, validNext = [validNext, 2]; end
            Vsp = max(qvp(validNext));
            
            Qa = Q(ih, itau, is, a);
            % Update: Q(s,a) <-- Q(s,a) + alpha * [ r + gamma * max Q(s') - Q(s,a) ]
            Q(ih, itau, is, a) = Qa + alpha * (r + gamma * Vsp - Qa);
            
            hL(t) = h;
            h = hNext; b = bNext; tauState = tauStateNext; tauPhys = tauPhysNext; s = sNext;
            eps = max(epsMin, eps * epsDecay);
        end
        
        res.all_hLog(:, iter) = hL;
        for y=1:nYears
            i0 = (y-1)*weeksPerYear+1; 
            i1 = y*weeksPerYear;
            res.all_minHealth(y, iter) = min(hL(i0:i1));
        end
    end
end

%% ======================= SIMULATION ENGINE (BASELINE) ===================
function res = run_fixed_simulation(P)
    % Fixed-Interval policy
    
    nIterations = P.nIterations;
    lambda1 = P.lambda1; betaWear = P.betaWear;
    gainHM = P.gainHM; costHM = P.costHM;
    nYears = P.nYears;
    weeksPerYear = 52;
    T = nYears * weeksPerYear;
    
    bound01 = @(x) min(1.0, max(0.0, x));
    
    maintInterval = 2; 
    budgetStopLimit = 0.90; 
    
    res.all_hLog           = zeros(T, nIterations);
    res.all_spentU_byYear  = zeros(nYears, nIterations);
    res.all_minHealth      = zeros(nYears, nIterations);
    
    for iter = 1:nIterations
        h = 1.0; b = 1.0; 
        tauPhys = 0;
        hL = zeros(T,1);
        currentYearSpend = 0.0;
        
        for t = 1:T
            currentWeekOfYear = mod(t-1, weeksPerYear) + 1;
            isScheduled = (mod(currentWeekOfYear, maintInterval) == 0);
            
            doMaint = false;
            if isScheduled
                 if (b >= costHM) && (currentYearSpend + costHM <= budgetStopLimit + 1e-9)
                     doMaint = true;
                 end
            end
            
            u_t = 0.0;
            if doMaint
                u_t = costHM;
                currentYearSpend = currentYearSpend + costHM;
            end
            
            if u_t == 0
                hNext = bound01(h - lambda1 * (tauPhys^betaWear));
                bNext = b;
                tauPhysNext = tauPhys + 1;
            else
                hNext = bound01(h - lambda1 * (tauPhys^betaWear) + gainHM);
                bNext = b - u_t;
                tauPhysNext = 0;
            end
            
            if mod(t, weeksPerYear) == 0
                yrIdx = t / weeksPerYear;
                res.all_spentU_byYear(yrIdx, iter) = 1.0 - bNext;
                bNext = 1.0; 
                currentYearSpend = 0.0; 
            end
            
            hL(t) = h;
            h = hNext; b = bNext; tauPhys = tauPhysNext;
        end
        
        res.all_hLog(:, iter) = hL;
        for y=1:nYears
            i0 = (y-1)*weeksPerYear+1; 
            i1 = y*weeksPerYear;
            res.all_minHealth(y, iter) = min(hL(i0:i1));
        end
    end
end
